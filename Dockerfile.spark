# apache/spark ships without numpy/pandas/pyarrow, which pyspark.ml imports
FROM apache/spark:3.5.4

USER root
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3-pip \
    && rm -rf /var/lib/apt/lists/* \
    && python3 -m pip install --no-cache-dir numpy pandas pyarrow
USER spark
